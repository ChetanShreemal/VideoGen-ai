# API
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
BETTER_AUTH_URL=http://127.0.0.1:4000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
RESEND_API_KEY=
AUTH_EMAIL_FROM=VideoGen <onboarding@resend.dev>
GEMINI_API_KEY=
# Optional DNS resolver IPs for Atlas SRV discovery if the system resolver refuses SRV queries.
# Example: MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
MONGODB_DNS_SERVERS=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=videogen_dev

# Optional until the reference-media upload API is enabled.
# Create an R2 API token scoped to the single VideoGen bucket.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ASSET_UPLOADS_ENABLED=false

# Web app. No provider credentials are needed for the scaffold.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1

# Add integration credentials only when the relevant implementation step begins.
