# API
API_HOST=127.0.0.1
API_PORT=4000
# Optional DNS resolver IPs for Atlas SRV discovery if the system resolver refuses SRV queries.
# Example: MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
MONGODB_DNS_SERVERS=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=videogen_dev

# Web app. No provider credentials are needed for the scaffold.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1

# Add integration credentials only when the relevant implementation step begins.
