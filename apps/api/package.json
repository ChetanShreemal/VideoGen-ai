{
  "name": "@videogen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @videogen/contracts",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace @videogen/contracts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "npm run build --workspace @videogen/contracts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@videogen/contracts": "0.1.0",
    "fastify": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
