{
  "name": "ai-videogen",
  "version": "0.1.0",
  "private": true,
  "description": "AI VideoGen application monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @videogen/web",
    "dev:api": "npm run dev --workspace @videogen/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
